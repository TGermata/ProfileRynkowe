<Window x:Class="MarketProfile.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MarketProfile.App.Controls"
        xmlns:vm="clr-namespace:MarketProfile.App.ViewModels"
        Title="Ustawienia" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="70" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style TargetType="controls:ColorPicker">
            <Setter Property="Margin" Value="4" />
        </Style>

        <!-- Szablon edycji schematu kolorów jednej sesji (używany dla sesji dziennej i nocnej). -->
        <DataTemplate DataType="{x:Type vm:ColorSchemeViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!-- Litery: każdy okres w innym kolorze albo wszystkie w jednym kolorze. -->
                <TextBlock Grid.Row="0" Text="Litery TPO" VerticalAlignment="Top" Margin="4,6,4,4" />
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                    <RadioButton Content="Każdy okres w innym kolorze (tęcza)" IsChecked="{Binding RainbowLetters}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Jeden kolor:" IsChecked="{Binding SingleColorLetters}"
                                     VerticalAlignment="Center" Margin="0,0,4,0" />
                        <controls:ColorPicker Color="{Binding LetterColor}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="POC" />
                <controls:ColorPicker Grid.Row="1" Grid.Column="1" Color="{Binding PocColor}" />

                <TextBlock Grid.Row="2" Text="Value Area" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <controls:ColorPicker Color="{Binding ValueAreaColor}" />
                    <TextBlock Text="krycie (%)" />
                    <TextBox Text="{Binding ValueAreaOpacity}" Width="40" />
                </StackPanel>

                <TextBlock Grid.Row="3" Text="Initial Balance" />
                <controls:ColorPicker Grid.Row="3" Grid.Column="1" Color="{Binding IbColor}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="12">
        <TabControl Width="640">

            <!-- ===== Zakładka: instrumenty – lista + edycja zaznaczonego ===== -->
            <TabItem Header="Instrumenty">
                <DockPanel Margin="8">
                    <!-- Przyciski listy. -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Dodaj" Padding="10,2" Click="OnAddInstrumentClick" />
                            <Button Content="Usuń" Padding="10,2" Margin="6,0,0,0" Click="OnRemoveInstrumentClick" />
                            <Button Content="Sprawdź w IB" Padding="10,2" Margin="6,0,0,0" Click="OnLookupInstrumentClick"
                                    IsEnabled="{Binding CanLookupInstrument}"
                                    ToolTip="Wyszukuje instrument w Interactive Brokers (TWS musi być uruchomiony) i uzupełnia giełdę, walutę, tick, strefę czasową i godziny sesji" />
                            <Button Content="Przywróć wbudowane" Padding="10,2" Margin="6,0,0,0" Click="OnRestoreInstrumentsClick"
                                    ToolTip="Dodaje brakujące instrumenty z gotowej listy (istniejących nie zmienia)" />
                        </StackPanel>
                        <TextBlock Text="{Binding InstrumentLookupResult}" TextWrapping="Wrap" Margin="2,6,2,0" MaxWidth="600"
                                   HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Lista instrumentów. -->
                    <ListBox DockPanel.Dock="Left" Width="200" Height="430" ItemsSource="{Binding InstrumentEditors}"
                             SelectedItem="{Binding SelectedInstrumentEditor}" DisplayMemberPath="DisplayName" />

                    <!-- Edycja zaznaczonego instrumentu. -->
                    <Grid DataContext="{Binding SelectedInstrumentEditor}" Margin="8,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Symbol" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="1" Text="Opis" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="250" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="2" Text="Rodzaj" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="4"
                                  ItemsSource="{Binding DataContext.InstrumentTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Type}" />

                        <TextBlock Grid.Row="3" Text="Symbol w IB / klasa" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding IbSymbol}" ToolTip="Puste = taki sam jak symbol (np. FDAX → DAX, 6E → EUR)" />
                            <TextBox Text="{Binding TradingClass}" ToolTip="Klasa kontraktu futures (np. FDAX, 6E) – puste = dowolna" />
                            <TextBlock Text="puste = jak symbol" Foreground="Gray" FontSize="11" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Text="Giełda / główna" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding Exchange}" ToolTip="Np. CME, NYMEX, EUREX; akcje: SMART" />
                            <TextBox Text="{Binding PrimaryExchange}" ToolTip="Akcje: giełda główna (np. NASDAQ, ARCA, NYSE)" />
                            <TextBlock Text="waluta" />
                            <TextBox Text="{Binding Currency}" Width="50" />
                        </StackPanel>

                        <TextBlock Grid.Row="5" Text="Tick / ticki na wiersz" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding TickSize}" ToolTip="Minimalna zmiana ceny, np. 0.25" />
                            <TextBox Text="{Binding TicksPerRow}" Width="50" ToolTip="Wysokość wiersza TPO w tickach dla tego instrumentu" />
                            <TextBlock Text="puste = jak w zakładce TPO" Foreground="Gray" FontSize="11" />
                        </StackPanel>

                        <TextBlock Grid.Row="6" Text="Strefa czasowa" />
                        <ComboBox Grid.Row="6" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="4" IsEditable="True"
                                  ItemsSource="{Binding DataContext.CommonTimeZones, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Text="{Binding TimeZoneId, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="W tej strefie podane są godziny sesji (i czas symulacji)" />

                        <TextBlock Grid.Row="7" Text="Sesja dzienna" />
                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding DayStart}" Width="55" />
                            <TextBlock Text="–" />
                            <TextBox Text="{Binding DayEnd}" Width="55" />
                            <TextBlock Text="GG:MM" Foreground="Gray" FontSize="11" />
                        </StackPanel>

                        <TextBlock Grid.Row="8" Text="Sesja nocna" />
                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding HasNightSession}" VerticalAlignment="Center" Margin="4" />
                            <TextBox Text="{Binding NightStart}" Width="55" IsEnabled="{Binding HasNightSession}" />
                            <TextBlock Text="–" />
                            <TextBox Text="{Binding NightEnd}" Width="55" IsEnabled="{Binding HasNightSession}" />
                            <TextBlock Text="może przechodzić przez północ" Foreground="Gray" FontSize="11" />
                        </StackPanel>

                        <TextBlock Grid.Row="9" Text="Miesiąc kontraktu" />
                        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding ContractMonth}" />
                            <TextBlock Text="futures: RRRRMM, puste = najbliższy" Foreground="Gray" FontSize="11" />
                        </StackPanel>

                        <TextBlock Grid.Row="10" Text="Cena odniesienia" />
                        <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding ReferencePrice}" />
                            <TextBlock Text="tylko dla generatora losowych cen" Foreground="Gray" FontSize="11" />
                        </StackPanel>

                        <TextBlock Grid.Row="11" Text="Dane do symulacji" />
                        <CheckBox Grid.Row="11" Grid.Column="1" Margin="4" VerticalAlignment="Center"
                                  Content="Pobieraj dane w tle (historia do symulacji)" IsChecked="{Binding DownloadData}"
                                  ToolTip="Po połączeniu z brokerem historia tego instrumentu jest pobierana w tle do lokalnej bazy – także gdy nie jest pokazany na wykresie" />

                        <TextBlock Grid.Row="12" Grid.ColumnSpan="2" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                                   Text="Każdy instrument ma własne dane w bazie, linie i rozbicia profili. Indeksy nie mają wolumenu – profil wolumenowy będzie pusty." />
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ===== Zakładka: TPO ===== -->
            <TabItem Header="TPO">
                <StackPanel Margin="8">
                    <GroupBox Header="TPO" Padding="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Wysokość wiersza (ticki)" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TicksPerRow}" />
                            <TextBlock Grid.Row="1" Text="Okres TPO (minuty)" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TpoMinutes}" />
                            <TextBlock Grid.Row="2" Text="Value Area (%)" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ValueAreaPercent}" />
                            <TextBlock Grid.Row="3" Text="Remis POC (równa odległość od środka)" />
                            <ComboBox Grid.Row="3" Grid.Column="1" Width="190" HorizontalAlignment="Left" Margin="4"
                                      ItemsSource="{Binding PocTieBreaks}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectedValue="{Binding PocTieBreak}"
                                      ToolTip="Którą cenę wybrać jako POC, gdy dwa wiersze mają tyle samo TPO i są równo oddalone od środka profilu" />
                        </Grid>
                    </GroupBox>

                    <!-- Elementy rysowane na profilach TPO – można je ukryć. -->
                    <GroupBox Header="Elementy profilu" Padding="6" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Pokazuj Initial Balance (pasek przy profilu)" VerticalAlignment="Center"
                                          IsChecked="{Binding ShowInitialBalance}" Margin="4" />
                                <TextBlock Text="okresów TPO w IB:" Margin="12,4,4,4" />
                                <TextBox Text="{Binding InitialBalancePeriods}" Width="40"
                                         ToolTip="Ile pierwszych okresów TPO tworzy Initial Balance (np. 2 = A i B)" />
                            </StackPanel>
                            <CheckBox Content="Pokazuj POC (ramka wiersza, wyróżnione litery, wartość w nagłówku)"
                                      IsChecked="{Binding ShowPoc}" Margin="4" />
                        </StackPanel>
                    </GroupBox>

                    <!-- HalfBack – linia na połowie wysokości profilu. -->
                    <GroupBox Header="HalfBack – połowa wysokości profilu" Padding="6" Margin="0,10,0,0">
                        <StackPanel>
                            <CheckBox Content="Rysuj linię HalfBack (środek między najwyższą a najniższą ceną profilu)"
                                      IsChecked="{Binding HalfBackEnabled}" Margin="4" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Linia" />
                                <ComboBox Width="110" Margin="4"
                                          ItemsSource="{Binding LineStyles}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                          SelectedValue="{Binding HalfBackLineStyle}" />
                                <TextBlock Text="Kolor" Margin="10,4,4,4" />
                                <controls:ColorPicker Color="{Binding HalfBackColor}" />
                                <TextBlock Text="Grubość (px)" Margin="10,4,4,4" />
                                <TextBox Text="{Binding HalfBackThickness}" Width="40" />
                                <TextBlock Text="Krycie (%)" Margin="10,4,4,4" />
                                <TextBox Text="{Binding HalfBackOpacity}" Width="40"
                                         ToolTip="100 = pełny kolor, mniej = bardziej przezroczysta linia" />
                            </StackPanel>
                            <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="4,4,4,0"
                                       Text="Linia jest rysowana pod literami przez całą szerokość profilu; w bieżącym profilu przesuwa się wraz ze zmianą zakresu." />
                        </StackPanel>
                    </GroupBox>

                    <!-- Strzałki początku (otwarcia) i końca (zamknięcia) rysowania profilu. -->
                    <GroupBox Header="Strzałki początku i końca profilu" Padding="6" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Początek (otwarcie) – po lewej" Width="210" VerticalAlignment="Center"
                                          IsChecked="{Binding ArrowShowOpen}" Margin="4" />
                                <controls:ColorPicker Color="{Binding ArrowOpenColor}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Koniec (zamknięcie) – po prawej" Width="210" VerticalAlignment="Center"
                                          IsChecked="{Binding ArrowShowClose}" Margin="4" />
                                <controls:ColorPicker Color="{Binding ArrowCloseColor}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Grubość (px)" />
                                <TextBox Text="{Binding ArrowThickness}" Width="40" />
                                <TextBlock Text="Wielkość grotu (px)" Margin="10,4,4,4" />
                                <TextBox Text="{Binding ArrowHeadSize}" Width="40" />
                                <TextBlock Text="Długość (px)" Margin="10,4,4,4" />
                                <TextBox Text="{Binding ArrowLength}" Width="40" />
                            </StackPanel>
                            <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="4,4,4,0"
                                       Text="Strzałki są skierowane w stronę profilu: początek wskazuje pierwszą cenę profilu, koniec – ostatnią (w bieżącym profilu przesuwa się z ceną)." />
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </TabItem>

            <!-- ===== Zakładka: Interactive Brokers – źródło danych w trybie „Na żywo” ===== -->
            <TabItem Header="Interactive Brokers">
                <StackPanel Margin="8">
                    <GroupBox Header="Źródło danych w trybie „Na żywo”" Padding="6">
                        <StackPanel>
                            <RadioButton Content="Generator losowych cen (do testów)" IsChecked="{Binding UseGeneratorLive}" Margin="4" />
                            <RadioButton Content="Interactive Brokers (TWS / IB Gateway)" IsChecked="{Binding UseInteractiveBrokers}" Margin="4" />
                        </StackPanel>
                    </GroupBox>

                    <!-- Ścieżka do biblioteki klienta TWS API – sprawdzana na bieżąco podczas wpisywania. -->
                    <GroupBox Header="Biblioteka klienta TWS API (CSharpAPI.dll)" Padding="6" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Wykryj" Padding="8,0" Margin="4,4,0,4" Click="OnIbAutoDetectClick"
                                        ToolTip="Szukaj folderu „TWS API” obok aplikacji i w C:\TWS API" />
                                <Button DockPanel.Dock="Right" Content="Przeglądaj…" Padding="8,0" Margin="4,4,0,4" Click="OnIbBrowseClick" />
                                <TextBox Text="{Binding IbApiPath, UpdateSourceTrigger=PropertyChanged}" Width="Auto" Margin="4"
                                         ToolTip="Plik CSharpAPI.dll albo folder, w którym ma być wyszukany (np. cały folder „TWS API”)" />
                            </DockPanel>
                            <TextBlock Text="{Binding IbApiStatus}" TextWrapping="Wrap" FontSize="11" MaxWidth="440"
                                       HorizontalAlignment="Left">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Firebrick" />
                                        <Setter Property="Margin" Value="4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IbApiValid}" Value="True">
                                                <Setter Property="Foreground" Value="ForestGreen" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Połączenie z TWS" Padding="6" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Adres" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding IbHost}" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="1" Text="Port" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding IbPort}" />
                                <TextBlock Text="TWS: 7497 demo / 7496 real, Gateway: 4002 / 4001" Foreground="Gray" FontSize="11" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Client ID" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding IbClientId}" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Foreground="Gray" FontSize="11"
                                       Text="Miesiąc kontraktu futures ustawiasz przy instrumencie (zakładka „Instrumenty”)." />

                            <TextBlock Grid.Row="4" Text="Rodzaj danych" />
                            <ComboBox Grid.Row="4" Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="4"
                                      ItemsSource="{Binding IbDataTypes}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectedValue="{Binding IbDataType}" />
                        </Grid>
                    </GroupBox>

                    <!-- Test połączenia: łączy, szuka kontraktu, czeka na notowanie i rozłącza. -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Testuj połączenie" Padding="10,2" Click="OnIbTestClick" IsEnabled="{Binding CanTestIb}" />
                        <Button Content="Sprawdź historię ticków" Padding="10,2" Margin="8,0,0,0" Click="OnIbTickProbeClick" IsEnabled="{Binding CanTestIb}"
                                ToolTip="Sprawdza w TWS, ile dni wstecz są dostępne ticki (transakcje) instrumentu z wykresu i ile trwałoby ich pobranie" />
                    </StackPanel>
                    <TextBlock Text="{Binding IbTestResult}" TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Left" Margin="4,6,4,0" />
                    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Left" Margin="4,6,4,0"
                               Text="Aplikacja tylko pobiera dane – nie składa zleceń. Test używa Client ID + 100. W TWS musi być włączone API: Configure → API → Settings → Enable ActiveX and Socket Clients." />
                </StackPanel>
            </TabItem>

            <!-- ===== Zakładka 2: dane, generator i baza danych ===== -->
            <!-- (Symulację – start, Play/Pause, prędkość – obsługuje się z paska w oknie głównym.) -->
            <TabItem Header="Dane">
                <StackPanel Margin="8">
                    <GroupBox Header="Dane" Padding="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Historia ładowana przed startem (dni)" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HistoryDays}" />
                            <TextBlock Grid.Row="1" Text="Przyspieszenie generatora w trybie „Na żywo” (×)" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SimulatorSpeed}" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Lokalna baza danych" Padding="6" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding DatabaseInfo}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DatabasePath}" Foreground="Gray" TextWrapping="Wrap" FontSize="11" />

                            <CheckBox Content="Zapisuj dane od brokera do bazy (do późniejszych symulacji)"
                                      IsChecked="{Binding RecordToDatabase}" Margin="4,8,4,4" />

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" IsEnabled="{Binding RecordToDatabase}">
                                <TextBlock Text="Dni historii pobieranej w tle (instrumenty z „Pobieraj dane”):" />
                                <TextBox Text="{Binding BackgroundHistoryDays}" Width="45" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" IsEnabled="{Binding RecordToDatabase}">
                                <TextBlock Text="Dni kompletnych ticków (każda transakcja, 0 = tylko świece):" />
                                <TextBox Text="{Binding BackgroundTickDays}" Width="45"
                                         ToolTip="Symulacja z ticków odtwarza rynek dokładnie tak, jak wyglądał (kolejność i wolumen każdej transakcji). Okresy bez ticków są odtwarzane całymi świecami 1-min (z ostrzeżeniem)." />
                            </StackPanel>
                            <CheckBox Content="Pokazuj pasek stanu pobierania ticków (postęp i komplet dni) w oknie głównym"
                                      IsChecked="{Binding ShowTickDownloadBar}" Margin="4,6,4,2" />
                            <TextBlock Foreground="Gray" TextWrapping="Wrap" FontSize="11"
                                       Text="Po połączeniu z brokerem brakujące dni świec 1-min, a potem ticków są pobierane w tle (osobne połączenie, Client ID + 1) – od najnowszych dni, z kontynuacją po ponownym uruchomieniu. Ticki pobierają się powoli (limit IB 60 zapytań / 10 min, ok. 40 min na dzień ES); przycisk „Sprawdź historię ticków” pokazuje szacunek." />

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Wygeneruj dane testowe" Padding="8,2" Margin="4"
                                        IsEnabled="{Binding CanGenerate}" Click="OnGenerateTestDataClick" />
                                <TextBlock Text="dni:" />
                                <TextBox Text="{Binding TestDataDays}" Width="40" />
                            </StackPanel>
                            <TextBlock Foreground="Gray" TextWrapping="Wrap" FontSize="11"
                                       Text="Dane testowe zastępują poprzednie dane testowe tego instrumentu. Dane od brokera nie są usuwane." />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- ===== Zakładka 2: wygląd profilu wolumenowego ===== -->
            <TabItem Header="Profil wolumenowy">
                <StackPanel Margin="8">
                    <!-- Dla których profili TPO rysować profil wolumenowy (to samo co „Wolumen” na pasku narzędzi). -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Rysuj profil wolumenowy dla:" />
                        <ComboBox Width="200" Margin="4" ItemsSource="{Binding VolumeModes}" DisplayMemberPath="Value"
                                  SelectedValuePath="Key" SelectedValue="{Binding VolumeMode}" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Odległość od profilu TPO (px)" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding VolumeGap}" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="1" Text="Długość najdłuższego słupka (px)" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding VolumeWidth}" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="2" Text="Kierunek słupków" VerticalAlignment="Top" Margin="4,6,4,4" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="4">
                            <RadioButton Content="Zwykły – od liter TPO w prawo"
                                         IsChecked="{Binding VolumeNormal}" />
                            <RadioButton Content="Odwrócony – w stronę liter TPO"
                                         IsChecked="{Binding VolumeMirrored}" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="Kolor słupków" />
                        <controls:ColorPicker Grid.Row="3" Grid.Column="1" Color="{Binding VolumeBarColor}" />

                        <TextBlock Grid.Row="4" Text="Kolor VPOC" />
                        <controls:ColorPicker Grid.Row="4" Grid.Column="1" Color="{Binding VolumeVpocColor}" />

                        <TextBlock Grid.Row="5" Text="Krycie słupków (%)" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding VolumeOpacity}" HorizontalAlignment="Left" />

                        <!-- Skalowanie – ograniczenie długości słupków przy dużym wolumenie. -->
                        <TextBlock Grid.Row="6" Text="Skala długości słupków" />
                        <ComboBox Grid.Row="6" Grid.Column="1" Width="130" HorizontalAlignment="Left" Margin="4"
                                  ItemsSource="{Binding VolumeScales}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding VolumeScale}" />

                        <TextBlock Grid.Row="7" Text="Limit (% największego wolumenu)" />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding VolumeCapPercent}" HorizontalAlignment="Left" />
                    </Grid>

                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="4,6,4,0" FontSize="11"
                               Text="Skala pierwiastkowa lub logarytmiczna spłaszcza duże wolumeny. Limit np. 60% – wolumen powyżej 60% maksimum ma pełną długość (z białym znacznikiem obcięcia), a pozostałe słupki są dłuższe i czytelniejsze. 100% = bez limitu." />

                    <!-- Profil wolumenowy aktualnie budowanego słupka TPO (bieżącego okresu). -->
                    <GroupBox Header="Wolumen bieżącego słupka TPO" Margin="0,10,0,0" Padding="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <CheckBox Grid.ColumnSpan="4" Margin="4" IsChecked="{Binding PeriodVolumeEnabled}"
                                      Content="Rysuj profil wolumenowy aktualnie budowanego słupka (przy bieżącym profilu)" />

                            <TextBlock Grid.Row="1" Text="Odstęp od liter TPO (px)" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PeriodVolumeGapFromTpo}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Odstęp do wolumenu sesji (px)" />
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding PeriodVolumeGapToSession}" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="2" Text="Długość najdłuższego słupka (px)" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PeriodVolumeWidth}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Krycie słupków (%)" />
                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding PeriodVolumeOpacity}" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="3" Text="Kolor słupków" />
                            <controls:ColorPicker Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Color="{Binding PeriodVolumeColor}" />

                            <!-- Skala: względem poprzednich słupków – na początku okresu słupki są krótkie i rosną z wolumenem. -->
                            <TextBlock Grid.Row="4" Text="Skala słupków" />
                            <ComboBox Grid.Row="4" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="4"
                                      ItemsSource="{Binding PeriodVolumeScaleModes}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectedValue="{Binding PeriodVolumeScaleMode}"
                                      ToolTip="Względem poprzednich słupków: pełna długość = typowy (mediana) największy wolumen wiersza z ostatnich zakończonych słupków tej samej sesji. Na początku okresu słupki są krótkie i rosną z wolumenem." />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Liczba słupków do odniesienia" />
                            <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding PeriodVolumeReferencePeriods}" HorizontalAlignment="Left" />
                        </Grid>
                    </GroupBox>

                    <!-- Liczby wolumenu przy słupkach (aktualnie zliczony wolumen wiersza). -->
                    <GroupBox Header="Liczby wolumenu przy słupkach" Margin="0,10,0,0" Padding="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <CheckBox Grid.ColumnSpan="2" Margin="4" IsChecked="{Binding VolumeLabelsOnSession}"
                                      Content="Przy profilu wolumenowym sesji" />
                            <CheckBox Grid.Column="2" Grid.ColumnSpan="2" Margin="4" IsChecked="{Binding VolumeLabelsOnPeriod}"
                                      Content="Przy wolumenie bieżącego słupka" />

                            <TextBlock Grid.Row="1" Text="Położenie liczby" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Width="170" HorizontalAlignment="Left" Margin="4"
                                      ItemsSource="{Binding VolumeLabelPositions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectedValue="{Binding VolumeLabelPosition}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Krycie tekstu (%)" />
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding VolumeLabelOpacity}" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="2" Text="Wielkość czcionki" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VolumeLabelFontSize}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Grubość czcionki" />
                            <ComboBox Grid.Row="2" Grid.Column="3" Width="130" HorizontalAlignment="Left" Margin="4"
                                      ItemsSource="{Binding FontWeights}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectedValue="{Binding VolumeLabelFontWeight}" />

                            <TextBlock Grid.Row="3" Text="Kolor tekstu" />
                            <controls:ColorPicker Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Color="{Binding VolumeLabelColor}" />
                        </Grid>
                    </GroupBox>

                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="4,10,4,4"
                               Text="To samo ustawienie („dla których profili”) jest też na pasku narzędzi okna głównego (Wolumen). Słupki mają wyraźniejszy obrys, więc są widoczne także przy niskim kryciu." />
                </StackPanel>
            </TabItem>

            <!-- ===== Zakładka 3: kolory profili sesji dziennej i nocnej ===== -->
            <TabItem Header="Kolory">
                <StackPanel Margin="8">
                    <GroupBox Header="Sesja dzienna" Padding="6">
                        <ContentControl Content="{Binding DayColors}" />
                    </GroupBox>
                    <GroupBox Header="Sesja nocna" Padding="6" Margin="0,10,0,0">
                        <ContentControl Content="{Binding NightColors}" />
                    </GroupBox>

                    <!-- Tryb Split: kreska na połowie każdego zakończonego słupka (okresu TPO). -->
                    <GroupBox Header="Tryb Split – kreska połowy słupka" Padding="6" Margin="0,10,0,0">
                        <StackPanel>
                            <CheckBox Content="Rysuj kreskę na połowie każdego zakończonego okresu TPO"
                                      IsChecked="{Binding MidlineEnabled}" Margin="4" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Kolor" />
                                <controls:ColorPicker Color="{Binding MidlineColor}" />
                                <TextBlock Text="Grubość (px)" Margin="12,4,4,4" />
                                <TextBox Text="{Binding MidlineThickness}" Width="40" />
                                <TextBlock Text="Krycie (%)" Margin="12,4,4,4" />
                                <TextBox Text="{Binding MidlineOpacity}" Width="40"
                                         ToolTip="100 = pełny kolor, mniej = bardziej przezroczysta kreska" />
                            </StackPanel>
                            <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="4,4,4,0"
                                       Text="Kreska jest rysowana pod literami – litery TPO pozostają w pełni widoczne." />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- ===== Zakładka: zegar bieżącego okresu TPO ===== -->
            <TabItem Header="Zegar TPO">
                <StackPanel Margin="8">
                    <CheckBox Content="Pokazuj zegar bieżącego okresu TPO (na żywo i w symulacji)"
                              IsChecked="{Binding TimerEnabled}" Margin="4" />

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Położenie" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="4"
                                  ItemsSource="{Binding TimerPositions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding TimerPosition}" />

                        <TextBlock Grid.Row="1" Text="Wielkość czcionki" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TimerFontSize}" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="2" Text="Grubość czcionki" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="4"
                                  ItemsSource="{Binding FontWeights}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding TimerFontWeight}" />

                        <TextBlock Grid.Row="3" Text="Kolor czcionki" />
                        <controls:ColorPicker Grid.Row="3" Grid.Column="1" Color="{Binding TimerColor}" />
                    </Grid>

                    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="4,10,4,0"
                               Text="Zegar pokazuje literę aktualnie rysowanego okresu TPO, jego przedział czasu i czas do końca okresu, np. „TPO F  10:00–10:30  ⏱ 12:34”. Czas liczony jest z danych: na żywo – z ostatniej transakcji, w symulacji – z zegara symulacji (w pauzie stoi)." />
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Komunikat o błędzie walidacji. -->
        <TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" MaxWidth="420" />

        <DockPanel Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Content="Przywróć domyślny wygląd" Padding="8,2" Click="OnResetAppearanceClick"
                    ToolTip="Przywraca domyślne kolory sesji i wygląd profilu wolumenowego" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Zapisz" Width="80" IsDefault="True" Click="OnSaveClick" />
                <Button Content="Anuluj" Width="80" Margin="6,0,0,0" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
