<UserControl x:Class="MarketProfile.App.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Pole wyboru koloru: tekst #RRGGBB, podgląd koloru i przycisk z paletą gotowych kolorów. -->
    <StackPanel Orientation="Horizontal">
        <TextBox x:Name="ColorText" Width="72" VerticalContentAlignment="Center"
                 TextChanged="OnTextChanged" />
        <Border x:Name="Swatch" Width="22" Height="18" Margin="4,0,2,0"
                BorderBrush="Gray" BorderThickness="1" />
        <ToggleButton x:Name="PaletteButton" Content="▾" Width="20" ToolTip="Wybierz z palety" />

        <Popup IsOpen="{Binding IsChecked, ElementName=PaletteButton, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=PaletteButton}" StaysOpen="False">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="4">
                <WrapPanel x:Name="PalettePanel" Width="158" />
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
