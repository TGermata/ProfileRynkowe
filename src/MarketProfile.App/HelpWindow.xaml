<Window x:Class="MarketProfile.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomoc – parametry profili (Market Profile wg J. Daltona)" Width="1100" Height="700" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2B5C8A" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Bottom" Foreground="#707070" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Opisy angielskie – terminologia Jima Daltona (Mind Over Markets, Markets in Profile), własnymi słowami. Pole „W aplikacji” mówi, jak dokładnie liczy to program. F1 otwiera pomoc z okna głównego i z tabeli „Parametry profili”." />

        <!-- Lista haseł z wyszukiwaniem -->
        <DockPanel DockPanel.Dock="Left" Width="330" Margin="0,0,10,0">
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,6" Padding="3"
                     TextChanged="OnSearchChanged" ToolTip="Szukaj w nazwach, skrótach i opisach (PL i EN)" />
            <ListBox x:Name="TopicList" SelectionChanged="OnTopicSelected" DisplayMemberPath="Title">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#2B5C8A" Margin="2,8,0,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>
        </DockPanel>

        <!-- Opis wybranego hasła -->
        <Border BorderBrush="#D0D5DB" BorderThickness="1" Padding="14,6,14,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Details" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding TermPl}" FontSize="14" Foreground="#505050" TextWrapping="Wrap" Margin="0,2,0,0" />

                    <TextBlock Text="English (J. Dalton)" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding DescriptionEn}" Style="{StaticResource Body}" />

                    <TextBlock Text="Po polsku" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding DescriptionPl}" Style="{StaticResource Body}" />

                    <TextBlock Text="W aplikacji" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding InApp}" Style="{StaticResource Body}" />

                    <TextBlock Text="Kolumny w bazie (profile_stats) i w CSV" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding Columns}" Style="{StaticResource Body}" FontFamily="Consolas" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
