<Window x:Class="MarketProfile.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MarketProfile.App.Controls"
        xmlns:vm="clr-namespace:MarketProfile.App.ViewModels"
        Title="Market Profile – TPO" Height="800" Width="1300"
        Background="#14171C" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <controls:TempoBrushConverter x:Key="TempoBrush" />
        <!-- Zamiana true/false na widoczny/ukryty (do pokazywania paska symulacji). -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8CDD4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Przyciski paska symulacji – kompaktowe (całość skaluje Ustawienia → Okno → Rozmiar kontrolek). -->
        <Style x:Key="SimButton" TargetType="Button">
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- Skok o cały profil (sesję) – ciemniejszy, ikona Windows „poprzedni / następny” (strzałka z kreską); odróżnia się od kroku o jeden słupek. -->
        <Style x:Key="SimProfileButton" TargetType="Button" BasedOn="{StaticResource SimButton}">
            <Setter Property="Background" Value="#3A4F6B" />
            <Setter Property="Foreground" Value="#E8EEF6" />
            <Setter Property="BorderBrush" Value="#5A7598" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- Krok o jeden słupek (okres TPO) – jasny, pojedyncza strzałka (ikona Windows: szewron w lewo / w prawo). -->
        <Style x:Key="SimBarButton" TargetType="Button" BasedOn="{StaticResource SimButton}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- Zakładki (ciemne): „Profil TPO” i „Wykres D/W/M”. -->
        <Style x:Key="DarkTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="#14171C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#808894" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Background="#1A1E24" BorderBrush="#2C313A" BorderThickness="1,1,1,0"
                                Padding="14,4" Margin="0,0,2,0" CornerRadius="4,4,0,0">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#2A3240" />
                                <Setter TargetName="Tab" Property="BorderBrush" Value="#5A7598" />
                                <Setter Property="Foreground" Value="#E8EEF6" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C8CDD4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Przełącznik interwału M / W / D – przycisk z zaznaczeniem. -->
        <Style x:Key="IntervalButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C8CDD4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="#262B33" BorderBrush="#3A4250" BorderThickness="1"
                                MinWidth="38" Height="26" Margin="0,0,4,0" CornerRadius="3" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#3A4F6B" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#5A7598" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#7A95B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Narzędzie w panelu narzędzi – przełącznik (zaznaczony = włączony). -->
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#C8CDD4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" Background="#262B33" BorderBrush="#3A4250" BorderThickness="1"
                                CornerRadius="3" Padding="8,3" Margin="0,0,3,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#3A4F6B" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#7A95B8" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#7A95B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SimSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="#4A5260" />
        </Style>
    </Window.Resources>

    <!-- Układ okna: paski narzędzi u góry, pasek statusu na dole, wykres w środku. -->
    <DockPanel>

        <!-- Pasek narzędzi: wybór instrumentu, tryb pracy, start/stop, ustawienia. -->
        <Border DockPanel.Dock="Top" Background="#1E2229" Padding="8,6">
            <Border.LayoutTransform>
                <ScaleTransform ScaleX="{Binding ControlScale}" ScaleY="{Binding ControlScale}" />
            </Border.LayoutTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Instrument:" Style="{StaticResource BarText}" Margin="0,0,6,0" />
                <ComboBox Width="230" MaxDropDownHeight="500"
                          ItemsSource="{Binding Instruments}"
                          SelectedItem="{Binding SelectedInstrument}" />

                <!-- Tryb pracy: dane na żywo albo symulacja z lokalnej bazy. -->
                <TextBlock Text="Tryb:" Style="{StaticResource BarText}" Margin="20,0,6,0" />
                <RadioButton Content="Na żywo" IsChecked="{Binding IsLiveMode}" Foreground="#C8CDD4"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                <RadioButton Content="Symulacja" IsChecked="{Binding IsSimulationMode}" Foreground="#C8CDD4"
                             VerticalAlignment="Center" />

                <!-- Start/Stop tylko dla generatora (symulacją sterują przyciski paska symulacji, a dane od brokera
                     łączą się same – przy brokerze przycisk pojawia się jako „⟳ Połącz” tylko, gdy połączenie nie działa). -->
                <Button Content="{Binding StartStopText}" Command="{Binding StartStopCommand}"
                        Width="80" Margin="12,0,0,0"
                        Visibility="{Binding ShowStartStop, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="⚙ Ustawienia" Click="OnSettingsClick" Width="100" Margin="6,0,0,0" />
                <Button Content="▤ Parametry profili" Click="OnProfileStatsClick" Padding="8,0" Margin="6,0,0,0"
                        ToolTip="Tabela parametrów profili (kształt, otwarcie, migracja VA, IB, ogony, nietknięte POC…) – zapisywanych w bazie dla algorytmów" />
                <Button Content="? Pomoc" Click="OnHelpClick" Padding="8,0" Margin="6,0,0,0"
                        ToolTip="Opis parametrów profili po angielsku (wg J. Daltona) i po polsku (F1)" />
                <Button Content="📄 Dziennik" Click="OnLogClick" Padding="8,0" Margin="6,0,0,0"
                        ToolTip="Dziennik zdarzeń i błędów z dzisiaj (połączenia z IB, przerwy w danych, błędy) – plik tekstowy w folderze z Ustawień (Dane i broker → Pobieranie i baza, domyślnie %AppData%\MarketProfile\logs).&#x0a;Pliki z ostatnich 30 dni są w tym samym folderze." />

                <!-- Elementy tylko dla zakładki „Profil TPO” (sesje, liczba profili, powiększenie, wolumen). -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsTpoTab, Converter={StaticResource BoolToVisibility}}">
                <!-- Szybkie pokazywanie/ukrywanie profili poszczególnych sesji. -->
                <TextBlock Text="Sesje:" Foreground="#C8CDD4" VerticalAlignment="Center" Margin="20,0,6,0" />
                <CheckBox Content="Nocna" IsChecked="{Binding ShowNightSession}" Foreground="#C8CDD4"
                          VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox Content="Dzienna" IsChecked="{Binding ShowDaySession}" Foreground="#C8CDD4"
                          VerticalAlignment="Center" />

                <!-- Ile ostatnich profili ma się mieścić na ekranie (dopasowanie szerokości + wczytanie historii). -->
                <TextBlock Text="Profile na ekranie:" Style="{StaticResource BarText}" Margin="20,0,6,0" />
                <ComboBox Width="55" ItemsSource="{Binding ProfileCountOptions}" SelectedItem="{Binding ProfilesOnScreen}"
                          ToolTip="Ile ostatnich profili zmieścić na ekranie przy dopasowaniu (⤢ / 2× klik / klawisz 0)." />

                <!-- Powiększanie widoku: oddal / przybliż / dopasuj do liczby profili. -->
                <Button Content="−" Width="26" Margin="8,0,0,0" Click="OnZoomOutClick"
                        ToolTip="Oddal – więcej profili na ekranie (kółko myszy w dół, klawisz −)" />
                <Button Content="+" Width="26" Margin="3,0,0,0" Click="OnZoomInClick"
                        ToolTip="Przybliż – zbliżenie na profil (kółko myszy w górę, klawisz +)" />
                <Button Content="⤢ Dopasuj" Padding="6,0" Margin="3,0,0,0" Click="OnZoomFitClick"
                        ToolTip="Dopasuj do wybranej liczby profili i wróć do najnowszych (2× klik na wykresie, klawisz 0)&#x0a;Kółko – powiększenie w obu osiach, Ctrl+kółko – tylko poziomo, Shift+kółko – tylko pionowo, przeciągnij – przesuń.&#x0a;Ctrl+przeciągnij linię cenową – kopia linii na nowej cenie (oryginał zostaje).&#x0a;Przesunięcie w lewo za najstarszy profil doczytuje starszą historię." />

                <!-- Profil wolumenowy: brak / tylko bieżący profil / wszystkie profile. -->
                <TextBlock Text="Wolumen:" Foreground="#C8CDD4" VerticalAlignment="Center" Margin="20,0,6,0" />
                <ComboBox Width="170" ItemsSource="{Binding VolumeModes}"
                          DisplayMemberPath="Value" SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedVolumeMode}" />
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Pasek symulacji (widoczny tylko w trybie symulacji) – kompaktowy, w jednym wierszu:
             czas (data + godzina), profil wstecz, słupek wstecz, ▶ Play, ⏸ Pauza, słupek w przód, profil w przód, ⏹ Reset,
             prędkość (◂ suwak ▸ lista), zegar, czas końca. Wielkość – Ustawienia → Okno → Rozmiar kontrolek. -->
        <Border DockPanel.Dock="Top" Background="#262B33" Padding="6,2" BorderBrush="#3A4250" BorderThickness="0,1,0,0"
                Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVisibility}}">
            <Border.LayoutTransform>
                <ScaleTransform ScaleX="{Binding ControlScale}" ScaleY="{Binding ControlScale}" />
            </Border.LayoutTransform>
            <!-- Grupy kontrolek zawijają się do drugiego wiersza, gdy okno jest za wąskie (nic nie jest ucinane). -->
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <DatePicker SelectedDate="{Binding SimStartDate}" Width="105" Height="22" VerticalAlignment="Center" FontSize="12"
                                ToolTip="Dzień symulacji – zmiana przenosi symulację do tego dnia" />
                    <TextBox Text="{Binding SimStartTime, UpdateSourceTrigger=PropertyChanged}" Width="42" Height="22" Margin="2,0,0,0"
                             VerticalContentAlignment="Center" FontSize="12"
                             GotKeyboardFocus="OnSimTimeGotFocus" LostKeyboardFocus="OnSimTimeLostFocus" KeyDown="OnSimTimeKeyDown"
                             ToolTip="Czas aktualnie rysowanego TPO (GG:MM, strefa instrumentu). Wpisz inną godzinę i naciśnij Enter: w przód – profile dorysują się płynnie, wstecz – od razu znikną. Wykres zostaje dopasowany do ekranu." />
                    <Border Style="{StaticResource SimSeparator}" />

                    <!-- Skoki: o cały profil (ciemne, pogrubione) i o jeden słupek TPO (jasne) – wstecz i w przód. -->
                    <Button ToolTip="Profil wstecz – cofnij do początku bieżącego profilu (z jego początku – do poprzedniego)"
                            Command="{Binding SimPrevProfileCommand}" Style="{StaticResource SimProfileButton}">
                        <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                    <Button ToolTip="Słupek wstecz – cofnij czas o jeden okres TPO (działa także w pauzie; przerwy bez danych są pomijane)"
                            Command="{Binding SimStepBackCommand}" Style="{StaticResource SimBarButton}">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                    <!-- Jeden przycisk: ▶ (odtwarzaj) ↔ ⏸ (pauza) – zmienia się po każdym naciśnięciu. -->
                    <Button Command="{Binding SimPlayPauseCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SimButton}">
                                <Setter Property="Content" Value="▶" />
                                <Setter Property="ToolTip" Value="Play – odtwarzaj (po zmianie startu wczytuje symulację od nowa)" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSimPlaying}" Value="True">
                                        <Setter Property="Content" Value="⏸" />
                                        <Setter Property="ToolTip" Value="Pauza – wstrzymaj odtwarzanie" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button ToolTip="Słupek w przód – przesuń czas o jeden okres TPO (działa także w pauzie)"
                            Command="{Binding SimStepCommand}" Style="{StaticResource SimBarButton}">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                    <Button ToolTip="Profil w przód – przeskocz do początku następnego profilu (działa także w pauzie)"
                            Command="{Binding SimNextProfileCommand}" Style="{StaticResource SimProfileButton}">
                        <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                    <Button Content="⏹" ToolTip="Reset – pauza i powrót do momentu, od którego wczytano symulację"
                            Command="{Binding SimResetCommand}" Style="{StaticResource SimButton}" />
                    <Border Style="{StaticResource SimSeparator}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <!-- Prędkość: suwak w skali logarytmicznej (×1 … ×3600), strzałki ◂ ▸ – skok do sąsiedniej gotowej prędkości,
                         lista – wybór gotowej prędkości. Wszystko działa od razu, także w trakcie odtwarzania. -->
                    <Button Content="◂" Command="{Binding SimSpeedDownCommand}" Width="16" Height="20" Padding="0"
                            FontSize="10" VerticalAlignment="Center" ToolTip="Wolniej – poprzednia prędkość z listy" />
                    <Slider Width="110" Minimum="0" Maximum="100" Value="{Binding SimSpeedSlider}" Margin="2,0"
                            VerticalAlignment="Center" SmallChange="1" LargeChange="10"
                            ToolTip="{Binding SimSpeedText}" />
                    <Button Content="▸" Command="{Binding SimSpeedUpCommand}" Width="16" Height="20" Padding="0"
                            FontSize="10" VerticalAlignment="Center" ToolTip="Szybciej – następna prędkość z listy" />
                    <!-- Lista gotowych prędkości; pole pokazuje krótko bieżącą prędkość (także pomiędzy gotowymi), lista – z opisem. -->
                    <ComboBox Width="68" Height="22" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"
                              ItemsSource="{x:Static vm:MainViewModel.SimSpeedPresets}"
                              SelectedItem="{Binding SelectedSimSpeedPreset}" TextSearch.TextPath="ShortLabel"
                              IsEditable="True" IsReadOnly="True" Text="{Binding SimSpeedShortText, Mode=OneWay}"
                              ToolTip="{Binding SimSpeedText}" />
                    <Border Style="{StaticResource SimSeparator}" />

                    <!-- Zegar symulacji. -->
                    <TextBlock Text="{Binding SimClock}" Foreground="#30C070" FontFamily="Consolas" FontSize="12"
                               VerticalAlignment="Center" ToolTip="Zegar symulacji" />
                    <TextBlock Text="{Binding TimeZoneLabel}" Foreground="#808894" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0" />
                    <Border Style="{StaticResource SimSeparator}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <!-- Opcjonalny czas końca: puste = bez ograniczeń; zatrzymuje tylko, gdy wpisano datę i godzinę. -->
                    <TextBlock Text="Koniec" Style="{StaticResource BarText}" FontSize="12" Margin="0,0,4,0" />
                    <DatePicker SelectedDate="{Binding SimEndDate}" Width="105" Height="22" VerticalAlignment="Center" FontSize="12"
                                ToolTip="Dzień końca symulacji – puste = bez ograniczeń. Zatrzymanie działa tylko, gdy wpisano też godzinę." />
                    <TextBox Text="{Binding SimEndTime}" Width="42" Height="22" Margin="2,0,0,0" VerticalContentAlignment="Center" FontSize="12"
                             KeyDown="OnSimEndTimeKeyDown"
                             ToolTip="Godzina końca (GG:MM, strefa instrumentu) – po dojściu do niej odtwarzanie się wstrzymuje. Puste = bez ograniczeń." />
                    <Button Content="✕" Width="20" Height="22" Margin="2,0,0,0" Padding="0" FontSize="11" Command="{Binding SimClearEndCommand}"
                            ToolTip="Usuń czas końca – odtwarzanie bez ograniczeń" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Pasek statusu: dane bieżącego profilu i tempo (dane rynkowe – komunikaty są tylko w polu informacji). -->
        <Border DockPanel.Dock="Bottom" Background="#1E2229" Padding="8,4">
            <StackPanel>
                <TextBlock Text="{Binding Summary}" Foreground="#C8CDD4" FontFamily="Consolas" />
                <!-- Tempo budowania TPO (liczba, stan, ostatnie zatrzymanie) – ukryte, gdy wyłączone. -->
                <TextBlock Text="{Binding TempoSummary}" FontFamily="Consolas" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"
                                    Value="{Binding TempoValue, Converter={StaticResource TempoBrush}, FallbackValue=#C8CDD4}" />
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <!-- Początek sesji – tempo jeszcze niemierzone: szary tekst, jak wskaźnik. -->
                                <DataTrigger Binding="{Binding TempoActive}" Value="False">
                                    <Setter Property="Foreground" Value="#6A717C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Pole informacji – JEDYNE miejsce komunikatów: błędy, ostrzeżenia o danych i krótkie podpowiedzi.
             Gdy wszystko działa – ukryte. Kolor zależy od wagi (podpowiedź / ostrzeżenie / błąd). -->
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0"
                Visibility="{Binding HasInfo, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding InfoText}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1B2A3A" />
                    <Setter Property="BorderBrush" Value="#2E4A66" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding InfoLevel}" Value="Warning">
                            <Setter Property="Background" Value="#8A4A00" />
                            <Setter Property="BorderBrush" Value="#FF9A2E" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding InfoLevel}" Value="Error">
                            <Setter Property="Background" Value="#7A1F1F" />
                            <Setter Property="BorderBrush" Value="#E05050" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding InfoText}" Foreground="White" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Wykres profili – kontrolka dostaje tylko migawki danych (oddzielenie prezentacji od modelu). -->
        <!-- Akcje użytkownika (linie, rozbijanie profili) kontrolka zgłasza zdarzeniami obsługiwanymi w MainWindow.xaml.cs. -->
        <!-- Zakładki: profile TPO i wykres świecowy szerszej perspektywy (dzienny / tygodniowy / miesięczny). -->
        <!-- Zakładkę można przenieść do osobnego okna (np. na drugi monitor) tylko przeciągając jej nagłówek z paska zakładek
             (w dół albo na drugi monitor). Zamknięcie tego okna odkłada zakładkę z powrotem. -->
        <Grid>
        <TextBlock x:Name="AllTabsDetachedText" Visibility="Collapsed" Foreground="#808894" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Text="Wszystkie zakładki są w osobnych oknach.&#x0a;Zamknij okno zakładki (albo „⇱ Wróć do okna głównego”), aby odłożyć ją tutaj." />
        <TabControl x:Name="Tabs" Style="{StaticResource DarkTabControl}" SelectedIndex="{Binding SelectedTab}">
            <TabItem x:Name="TpoTabItem" Header="Profil TPO" Tag="tpo">
                <Grid>
                    <controls:ProfileChartControl x:Name="Chart"
                                                  Profiles="{Binding Profiles}"
                                                  Lines="{Binding Lines}"
                                                  FlashingAlerts="{Binding FlashingAlerts}"
                                                  Averages="{Binding TpoAverages}"
                                                  Appearance="{Binding Appearance}"
                                                  PeriodTimerText="{Binding PeriodTimerText}"
                                                  TempoValue="{Binding TempoValue}"
                                                  TempoActive="{Binding TempoActive}"
                                                  SimulationMenu="{Binding IsSimulationMode}"
                                                  TempoStateText="{Binding TempoStateLabel}"
                                                  CrosshairEnabled="{Binding ShowCrosshair}"
                                                  ProfileNotes="{Binding ProfileStatsList}" NotesStyle="{Binding NotesStyle}"
                                                  ProfilesToFit="{Binding ProfilesOnScreen}" />

                    <!-- Panel narzędzi szybkiego dostępu nad wykresem – przesuwany za nagłówek, zwijany strzałką.
                         Nowe narzędzia dodaje się jako kolejne przyciski w Tools. -->
                    <Canvas x:Name="ToolPanelCanvas" ClipToBounds="True">
                        <controls:FloatingToolPanel x:Name="ToolPanel" IsCollapsed="{Binding ToolPanelCollapsed}">
                            <controls:FloatingToolPanel.Tools>
                                <WrapPanel Orientation="Horizontal">
                                    <ToggleButton Content="✛ Kursor" IsChecked="{Binding ShowCrosshair}" Style="{StaticResource ToolToggle}"
                                                  ToolTip="Kursor z liniami: cena na osi cen, profil i słupek TPO (litera, godziny) na dole wykresu (klawisz C)" />
                                </WrapPanel>
                            </controls:FloatingToolPanel.Tools>
                        </controls:FloatingToolPanel>

                        <!-- Karta „Otwarcie”: pojawia się, gdy zaczyna się nowy profil (symulacja: skok ⏭ / ⏮ albo odtwarzanie;
                             na żywo: otwarcie sesji). Przesuwana za nagłówek, zwijana strzałką, ✕ zamyka do następnego profilu. -->
                        <controls:FloatingToolPanel x:Name="OpeningPanel" Title="⠿ Otwarcie"
                                                    Visibility="{Binding OpeningCardVisible, Converter={StaticResource BoolToVisibility}}">
                            <controls:FloatingToolPanel.Tools>
                                <StackPanel MaxWidth="560" Margin="2,0,2,2">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="✕" Click="OnCloseOpeningCardClick" Focusable="False"
                                                Padding="5,0" Margin="8,0,0,0" FontSize="10" Background="Transparent"
                                                Foreground="#C8CDD4" BorderThickness="0" Cursor="Hand"
                                                ToolTip="Zamknij kartę (pojawi się przy następnym profilu)" />
                                        <TextBlock Text="{Binding OpeningCardTitle}" Foreground="#E8ECF0" FontWeight="SemiBold"
                                                   FontSize="12" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding OpeningCardLines}" Grid.IsSharedSizeScope="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="OpeningLabel" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="OpeningAccent" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Foreground="#9AA2AE" FontSize="11" Margin="0,0,10,0"
                                                               VerticalAlignment="Center" />
                                                    <!-- Akcent: kierunek spodziewanej korekty inwentarza (↑ zielona / ↓ czerwona) albo ✓ -->
                                                    <TextBlock Grid.Column="1" Text="{Binding Accent}" Foreground="{Binding AccentBrush}"
                                                               FontSize="15" FontWeight="Bold" Margin="0,-3,6,0" VerticalAlignment="Center"
                                                               Visibility="{Binding HasAccent, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="11" TextWrapping="Wrap"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#E0E4E8" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDim}" Value="True">
                                                                        <Setter Property="Foreground" Value="#7A828E" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Mini-wykres: w której części zakresu poprzedniego dnia jest otwarcie -->
                                                    <controls:OpeningRangeGauge Grid.Column="3" Data="{Binding Gauge}" Margin="8,0,0,0"
                                                                                Visibility="{Binding HasGauge, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </controls:FloatingToolPanel.Tools>
                        </controls:FloatingToolPanel>

                        <!-- Menu „Wyświetlanie”: co ma być na wykresie. Przesuwane za nagłówek, zwijane strzałką. -->
                        <controls:FloatingToolPanel x:Name="DisplayPanel" Title="⠿ Wyświetlanie" IsCollapsed="{Binding DisplayPanelCollapsed}">
                            <controls:FloatingToolPanel.Tools>
                                <WrapPanel Orientation="Horizontal" MaxWidth="500">
                                    <WrapPanel.Resources>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="Foreground" Value="#C8CDD4" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Margin" Value="0,2,0,0" />
                                            <Setter Property="Focusable" Value="False" />
                                        </Style>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="Foreground" Value="#C8CDD4" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Margin" Value="0,2,0,0" />
                                            <Setter Property="Focusable" Value="False" />
                                        </Style>
                                        <Style x:Key="MenuGroup" TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#8FA6C4" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Margin" Value="0,4,0,1" />
                                        </Style>
                                        <Style x:Key="MenuColumn" TargetType="StackPanel">
                                            <Setter Property="Width" Value="158" />
                                            <Setter Property="Margin" Value="2,0,6,4" />
                                        </Style>
                                    </WrapPanel.Resources>

                                    <StackPanel Style="{StaticResource MenuColumn}">
                                        <TextBlock Text="Sesje" Style="{StaticResource MenuGroup}" />
                                        <CheckBox Content="Nocna" IsChecked="{Binding ShowNightSession}" />
                                        <CheckBox Content="Dzienna" IsChecked="{Binding ShowDaySession}" />

                                        <TextBlock Text="Profil" Style="{StaticResource MenuGroup}" />
                                        <CheckBox Content="IB – Initial Balance" IsChecked="{Binding ShowInitialBalance}" />
                                        <CheckBox Content="Strzałka otwarcia" IsChecked="{Binding ShowOpenArrow}" />
                                        <CheckBox Content="Strzałka zamknięcia" IsChecked="{Binding ShowCloseArrow}" />
                                        <CheckBox Content="Wolumen bieżącego słupka" IsChecked="{Binding ShowPeriodVolume}" />
                                        <TextBlock Text="Profil wolumenowy:" Foreground="#C8CDD4" FontSize="11" Margin="0,4,0,1" />
                                        <ComboBox ItemsSource="{Binding VolumeModes}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                                  SelectedValue="{Binding SelectedVolumeMode}" FontSize="11" Focusable="False" />
                                        <RadioButton GroupName="VolumeDisplay" Content="Tradycyjny (wolumen)" IsChecked="{Binding VolumeDisplayTotal}" />
                                        <RadioButton GroupName="VolumeDisplay" Content="Różnicowy (delta kupno − sprzedaż)" IsChecked="{Binding VolumeDisplayDelta}"
                                                     ToolTip="Słupek = wolumen kupna − wolumen sprzedaży w wierszu (zielony: przewaga kupna, czerwony: sprzedaży). Strona transakcji z notowań bid/ask; starsze ticki – reguła ticka; świece 1-min nie mają strony." />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource MenuColumn}">
                                        <TextBlock Text="Opisy dnia" Style="{StaticResource MenuGroup}" />
                                        <CheckBox Content="HB – halfback (połowa zakresu)" IsChecked="{Binding ShowHalfback}" />
                                        <CheckBox Content="S – SETTLE (Close / wpis ręczny)" IsChecked="{Binding ShowSettle}" />
                                        <CheckBox Content="PBL / PBH – pullback" IsChecked="{Binding ShowPullback}" />
                                        <CheckBox Content="Karta otwarcia" IsChecked="{Binding ShowOpeningCard}"
                                                  ToolTip="Przy nowym profilu (symulacja i na żywo): otwarcie vs VA poprz. dnia, GAP, inwentarz, noc, HB, typ otwarcia" />
                                        <CheckBox Content="Opis pod profilem" IsChecked="{Binding ShowNoteText}"
                                                  ToolTip="Pod profilem dnia: migracja VA względem poprzedniego dnia (albo dzień trendowy), otwarcie względem nocy (ONH / ONL), inwentarz względem SETTLE poprzedniego dnia, GAP względem High / Low poprzedniego dnia" />

                                        <TextBlock Text="Poziomy nocy (ONH/ONL/ONPOC)" Style="{StaticResource MenuGroup}" TextWrapping="Wrap" />
                                        <RadioButton GroupName="OvernightLevels" Content="Ostatni dzień" IsChecked="{Binding OvernightLevelsLastDay}" />
                                        <RadioButton GroupName="OvernightLevels" Content="Wszystkie dni" IsChecked="{Binding OvernightLevelsAllDays}" />
                                        <RadioButton GroupName="OvernightLevels" Content="Wyłączone" IsChecked="{Binding OvernightLevelsNone}" />

                                        <TextBlock Text="Poziomy alarmowe" Style="{StaticResource MenuGroup}" />
                                        <CheckBox Content="🔔 Alarmy dźwiękowe" IsChecked="{Binding PriceAlertsEnabled}"
                                                  ToolTip="Dźwięk przy przebiciu poziomu alarmowego (dodawanie: prawy przycisk myszy na wykresie)" />
                                        <CheckBox Content="Alarmy w symulacji" IsChecked="{Binding PriceAlertsInSimulation}"
                                                  IsEnabled="{Binding PriceAlertsEnabled}" />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource MenuColumn}">
                                        <TextBlock Text="Średnie SMA (D)" Style="{StaticResource MenuGroup}" />
                                        <CheckBox Content="Pokazuj średnie" IsChecked="{Binding ShowTpoAverages}"
                                                  ToolTip="Linie / pasy średnich z wykresu dziennego na wykresie TPO (styl: Ustawienia → Wykres D/W/M)" />
                                        <ItemsControl ItemsSource="{Binding TpoAverageToggles}" Margin="14,0,0,0"
                                                      IsEnabled="{Binding ShowTpoAverages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsVisible}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </WrapPanel>
                            </controls:FloatingToolPanel.Tools>
                        </controls:FloatingToolPanel>
                    </Canvas>
                </Grid>
            </TabItem>

            <TabItem x:Name="CandlesTabItem" Header="Wykres D/W/M" Tag="candles">
                <DockPanel>
                    <!-- Interwał, odświeżenie z IB i opis danych w bazie. -->
                    <Border DockPanel.Dock="Top" Background="#1E2229" Padding="8,5" BorderBrush="#2C313A" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <!-- Instrument bazowy albo rynek szeroki (np. ES / SPX) – ukryte, gdy wybrany instrument to sam rynek szeroki. -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasBroadMarketSwitch, Converter={StaticResource BoolToVisibility}}">
                                    <RadioButton Content="{Binding BaseSymbolLabel}" GroupName="CandleSymbol" IsChecked="{Binding IsBaseSelected}"
                                                 Style="{StaticResource IntervalButton}" ToolTip="Wybrany instrument" />
                                    <RadioButton Content="{Binding BroadSymbolLabel}" GroupName="CandleSymbol" IsChecked="{Binding IsBroadSelected}"
                                                 Style="{StaticResource IntervalButton}" ToolTip="{Binding BroadSymbolToolTip}" />
                                    <Border Style="{StaticResource SimSeparator}" Margin="10,0" />
                                </StackPanel>
                                <RadioButton Content="M" GroupName="CandleInterval" IsChecked="{Binding IsMonthly}"
                                             Style="{StaticResource IntervalButton}" ToolTip="Świece miesięczne (20 lat)" />
                                <RadioButton Content="W" GroupName="CandleInterval" IsChecked="{Binding IsWeekly}"
                                             Style="{StaticResource IntervalButton}" ToolTip="Świece tygodniowe (10 lat)" />
                                <RadioButton Content="D" GroupName="CandleInterval" IsChecked="{Binding IsDaily}"
                                             Style="{StaticResource IntervalButton}" ToolTip="Świece dzienne – pełna doba z sesją nocną (5 lat)" />

                                <!-- Rodzaj prezentacji (zapisywany w ustawieniach; kolory i średnie – Ustawienia → Wykres D/W/M). -->
                                <Border Style="{StaticResource SimSeparator}" Margin="10,0" />
                                <RadioButton Content="Świece" GroupName="CandleType" IsChecked="{Binding IsCandlesType}"
                                             Style="{StaticResource IntervalButton}" ToolTip="Świece japońskie" />
                                <RadioButton Content="OHLC" GroupName="CandleType" IsChecked="{Binding IsOhlcType}"
                                             Style="{StaticResource IntervalButton}" ToolTip="Słupki OHLC: kreska maksimum–minimum, otwarcie w lewo, zamknięcie w prawo" />

                                <!-- Cała doba / tylko sesja kasowa (kontrakty terminowe; indeks ma zawsze tylko sesję kasową). -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasCashSessionSwitch, Converter={StaticResource BoolToVisibility}}">
                                    <Border Style="{StaticResource SimSeparator}" Margin="10,0" />
                                    <RadioButton Content="Doba" GroupName="CandleSession" IsChecked="{Binding IsFullDaySession}"
                                                 Style="{StaticResource IntervalButton}"
                                                 ToolTip="Świece z całej doby handlowej (sesja nocna + dzienna)" />
                                    <RadioButton Content="Kasowa" GroupName="CandleSession" IsChecked="{Binding IsCashSessionOnly}"
                                                 Style="{StaticResource IntervalButton}"
                                                 ToolTip="Świece tylko z sesji kasowej (dziennej, bez notowań nocnych) – osobna seria pobierana z IBKR" />
                                </StackPanel>

                                <!-- Skala: poziomo (szerokość świec) i pionowo (automatyczna / ręczna). -->
                                <Border Style="{StaticResource SimSeparator}" Margin="10,0" />
                                <Button Content="−" Width="26" Height="26" Click="OnCandleZoomOutClick"
                                        ToolTip="Węższe świece – więcej świec na ekranie (kółko myszy w dół)" />
                                <Button Content="+" Width="26" Height="26" Margin="3,0,0,0" Click="OnCandleZoomInClick"
                                        ToolTip="Szersze świece – mniej świec na ekranie (kółko myszy w górę)" />
                                <Button Content="↕ Skala auto" Padding="8,0" Height="26" Margin="3,0,0,0" Click="OnCandleAutoScaleClick"
                                        ToolTip="Skala pionowa dopasowana do widocznych świec (2× klik na osi cen).&#x0a;Skalę pionową zmienisz przeciągając oś cen w górę/w dół, kółkiem nad osią cen albo Shift+kółko." />
                                <Button Content="⤢ Najnowsze" Padding="8,0" Height="26" Margin="3,0,0,0" Click="OnCandleFitClick"
                                        ToolTip="Najnowsze świece przy prawej krawędzi, domyślna szerokość i skala auto (2× klik na wykresie).&#x0a;Przeciągnij – przesuń (przy ręcznej skali także w pionie).&#x0a;Wolne miejsce za najnowszą świecą zmienisz, przeciągając pionową kropkowaną linię końca wykresu." />
                            </StackPanel>
                            <TextBlock Text="{Binding CandleInfo}" Foreground="#808894" VerticalAlignment="Center" Margin="16,0,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding CandleInfo}" />
                        </DockPanel>
                    </Border>
                    <controls:CandleChartControl x:Name="CandleChart"
                                                 Bars="{Binding CandleBars}"
                                                 Interval="{Binding CandleInterval}"
                                                 TickSize="{Binding CandleTickSize}"
                                                 Appearance="{Binding CandleAppearance}"
                                                 EmptyText="{Binding CandleEmptyText}"
                                                 RightMarginPercent="{Binding CandleRightMargin}" />
                </DockPanel>
            </TabItem>

            <TabItem x:Name="VolumeTabItem" Header="Wolumen dziś / wczoraj" Tag="volume">
                <DockPanel>
                    <!-- Które sesje są porównywane i suma do teraz. -->
                    <Border DockPanel.Dock="Top" Background="#1E2229" Padding="10,6" BorderBrush="#2C313A" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding VolumeSummary}" Foreground="#C8CDD4" FontSize="13"
                                   ToolTip="Wolumen bieżącej sesji w okresach TPO w porównaniu z tymi samymi okresami poprzedniej sesji tego samego rodzaju (dzienna z dzienną, nocna z nocną).&#x0a;Okres w trakcie porównywany jest do tej samej minuty. Odświeżanie co sekundę." />
                    </Border>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="150" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="2*" MinHeight="100" />
                        </Grid.RowDefinitions>

                        <!-- Okresy TPO (dziś / poprzednia sesja / różnica) i obok wolumen całkowity sesji. -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>
                            <controls:VolumeCompareChartControl Grid.Column="0" Result="{Binding VolumeResult}"
                                                                SelectedIndex="{Binding VolumeSelectedIndex}" />
                            <controls:SessionVolumeChartControl Grid.Column="1" Result="{Binding VolumeResult}"
                                                                ToolTip="Wolumen całkowity profilu: dziś do teraz, poprzednia sesja do tej samej chwili i cała poprzednia sesja (przerywana ramka – ile wolumenu zwykle przychodzi do końca sesji)." />
                        </Grid>
                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#2C313A" />

                        <DataGrid x:Name="VolumeGrid" Grid.Row="2" ItemsSource="{Binding VolumeRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectedIndex="{Binding VolumeSelectedIndex, Mode=TwoWay}" SelectionChanged="OnVolumeGridSelectionChanged"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False"
                                  CanUserReorderColumns="False" SelectionMode="Single"
                                  Background="#14171C" AlternationCount="2"
                                  Foreground="#C8CDD4" BorderThickness="0" HorizontalGridLinesBrush="#262B33"
                                  FontFamily="Consolas" FontSize="13">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E2229" />
                                    <Setter Property="Foreground" Value="#808894" />
                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                    <Setter Property="Padding" Value="10,5" />
                                    <Setter Property="BorderBrush" Value="#2C313A" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="10,3" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <!-- Zaznaczony wiersz (także kliknięciem słupków na wykresie) – w kolorze zaznaczenia wykresu. -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#24405F" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <!-- Liczby wyrównane do prawej. -->
                                <Style x:Key="NumberCell" TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                                <!-- Różnica: zielona = więcej niż w poprzedniej sesji, czerwona = mniej. -->
                                <Style x:Key="DiffCell" TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Sign}" Value="1">
                                            <Setter Property="Foreground" Value="#30C070" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Sign}" Value="-1">
                                            <Setter Property="Foreground" Value="#E05050" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <!-- Tło wierszy w stylu (nie RowBackground – DataGrid wymusza je i zasłania zaznaczenie). -->
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#181C22" />
                                    <Style.Triggers>
                                        <Trigger Property="AlternationIndex" Value="1">
                                            <Setter Property="Background" Value="#1C2027" />
                                        </Trigger>
                                        <!-- Okres w trakcie – pogrubiony; okresy przyszłe – przygaszone. -->
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Background" Value="#2A2A1E" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                            <Setter Property="Foreground" Value="#5A626E" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Litera" Binding="{Binding Letter}" Width="60" />
                                <DataGridTextColumn Header="Godziny" Binding="{Binding Hours}" Width="190" />
                                <DataGridTextColumn Header="Dziś" Binding="{Binding Today}" Width="130" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Poprzednia sesja" Binding="{Binding Previous}" Width="140" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Różnica" Binding="{Binding Difference}" Width="130" ElementStyle="{StaticResource DiffCell}" />
                                <DataGridTextColumn Header="Różnica %" Binding="{Binding DifferencePercent}" Width="100" ElementStyle="{StaticResource DiffCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Szeroki rynek: dzienny wykres rynku szerokiego (SPX, sesja kasowa) z EMA z ustawień,
                 jeden wiersz wskaźnika nad wykresem i dwa pod nim – kolumny świec wspólne dla wszystkich wierszy. -->
            <TabItem x:Name="BroadTabItem" Header="Szeroki rynek" Tag="broad">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#1E2229" Padding="8,5" BorderBrush="#2C313A" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="{Binding BroadTitle}" Foreground="#C8CDD4" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0" />
                                <!-- Stan notowań na żywo: zielony – na żywo, żółty – opóźnione / brak notowań / sesja zamknięta. -->
                                <TextBlock Text="{Binding BroadDataStatus}" VerticalAlignment="Center" Margin="10,0,0,0"
                                           ToolTip="Stan notowań rynku szerokiego z IB (bieżąca świeca 30 min).">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#F0C030" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BroadDataLive}" Value="True">
                                                    <Setter Property="Foreground" Value="#30C070" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Style="{StaticResource SimSeparator}" Margin="10,0" />
                                <Button Content="−" Width="26" Height="26" Click="OnBroadZoomOutClick"
                                        ToolTip="Węższe świece – więcej świec na ekranie (kółko myszy w dół)" />
                                <Button Content="+" Width="26" Height="26" Margin="3,0,0,0" Click="OnBroadZoomInClick"
                                        ToolTip="Szersze świece – mniej świec na ekranie (kółko myszy w górę)" />
                                <Button Content="↕ Skala auto" Padding="8,0" Height="26" Margin="3,0,0,0" Click="OnBroadAutoScaleClick"
                                        ToolTip="Skala pionowa dopasowana do widocznych świec (2× klik na osi cen)." />
                                <Button Content="⤢ Najnowsze" Padding="8,0" Height="26" Margin="3,0,0,0" Click="OnBroadFitClick"
                                        ToolTip="Najnowsze świece przy prawej krawędzi, domyślna szerokość i skala auto (2× klik na wykresie).&#x0a;Wolne miejsce za najnowszą świecą zmienisz, przeciągając pionową kropkowaną linię końca wykresu." />
                            </StackPanel>
                            <TextBlock Text="{Binding BroadInfo}" Foreground="#808894" VerticalAlignment="Center" Margin="16,0,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding BroadInfo}" />
                        </DockPanel>
                    </Border>
                    <!-- Na dole zakładki: pasek 11 sektorów S&P 500 (od największej wagi): waga w indeksie i zmiana od otwarcia sesji kasowej (ETF-y SPDR). -->
                    <Border DockPanel.Dock="Bottom" Background="#14171C" BorderBrush="#2C313A" BorderThickness="0,1,0,0"
                            Visibility="{Binding ShowSectorStrip, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding SectorInfo}" Foreground="#A0761E" FontSize="10" Margin="6,0,6,2"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <controls:SectorStripControl Tiles="{Binding SectorTiles}" Height="40" />
                        </DockPanel>
                    </Border>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70" />
                            <RowDefinition Height="*" MinHeight="150" />
                        </Grid.RowDefinitions>
                        <!-- Wiersz nad wykresem: kolumny po 15% szerokości; w pierwszej – Oddech rynku (wolumen kupna / sprzedaży SPY z bid/ask od 9:30 ET),
                             w drugiej – Oddech rynku NYSE (VOL-NYSE), w trzeciej i czwartej – spółki rosnące / spadające NYSE i NASDAQ (AD-NYSE, AD-NASD). -->
                        <Border Grid.Row="0" Background="#14171C" BorderBrush="#2C313A" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="#2C313A" BorderThickness="0,0,1,0">
                                    <controls:MarketBreathControl Title="ODDECH RYNKU · SPY" Value="{Binding BreathValue}" Detail="{Binding BreathDetail}"
                                                                  ShowGauge="{Binding ShowBreathGauge}"
                                                                  ToolTip="Oddech rynku: od otwarcia sesji kasowej (9:30 ET) rzeczywisty wolumen kupna (transakcje po ask) i sprzedaży (po bid) SPY.&#x0a;Przewaga kupna = kupno / sprzedaż (np. +1,25), przewaga sprzedaży = −(sprzedaż / kupno) (np. −1,25)." />
                                </Border>
                                <Border Grid.Column="1" BorderBrush="#2C313A" BorderThickness="0,0,1,0">
                                    <controls:MarketBreathControl Title="ODDECH RYNKU · NYSE" Value="{Binding NyseBreathValue}" Detail="{Binding NyseBreathDetail}"
                                                                  ShowGauge="{Binding ShowBreathGauge}"
                                                                  ToolTip="Oddech rynku – cała NYSE: wolumen spółek rosnących / spadających względem wczorajszego zamknięcia (dane IB VOL-NYSE, od otwarcia).&#x0a;Przewaga wzrostów = w górę / w dół (np. +1,25), przewaga spadków = −(w dół / w górę) (np. −1,25)." />
                                </Border>
                                <Border Grid.Column="2" BorderBrush="#2C313A" BorderThickness="0,0,1,0">
                                    <controls:AdvanceDeclineControl Title="SPÓŁKI ▲▼ · NYSE" Data="{Binding NyseAdvanceDecline}"
                                                                    ShowGauge="{Binding ShowBreathGauge}"
                                                                    >
                                        <controls:AdvanceDeclineControl.ToolTip>
                                            <TextBlock Text="{Binding NyseAdvanceDecline.Detail, StringFormat='Ile spółek NYSE rośnie (▲), a ile spada (▼) względem wczorajszego zamknięcia (dane IB AD-NYSE).&#x0a;Zielony – więcej rosnących, czerwony – więcej spadających.&#x0a;{0}'}" />
                                        </controls:AdvanceDeclineControl.ToolTip>
                                    </controls:AdvanceDeclineControl>
                                </Border>
                                <Border Grid.Column="3" BorderBrush="#2C313A" BorderThickness="0,0,1,0">
                                    <controls:AdvanceDeclineControl Title="SPÓŁKI ▲▼ · NASDAQ" Data="{Binding NasdaqAdvanceDecline}"
                                                                    ShowGauge="{Binding ShowBreathGauge}"
                                                                    >
                                        <controls:AdvanceDeclineControl.ToolTip>
                                            <TextBlock Text="{Binding NasdaqAdvanceDecline.Detail, StringFormat='Ile spółek NASDAQ rośnie (▲), a ile spada (▼) względem wczorajszego zamknięcia (dane IB AD-NASD).&#x0a;Zielony – więcej rosnących, czerwony – więcej spadających.&#x0a;{0}'}" />
                                        </controls:AdvanceDeclineControl.ToolTip>
                                    </controls:AdvanceDeclineControl>
                                </Border>
                                <!-- Po prawej (żółte tło): o ile % cena SPX jest nad / pod EMA8 i EMA21 z wykresu 30 min. -->
                                <Border Grid.Column="4" BorderBrush="#2C313A" BorderThickness="0,0,1,0">
                                    <controls:EmaDistanceControl Title="SPX VS EMA8" Value="{Binding Ema8Distance}" Detail="{Binding Ema8Detail}"
                                                                 ToolTip="O ile procent bieżąca cena SPX jest nad (▲) albo pod (▼) EMA8 ze świec 30 min (sesja kasowa) – tą samą co linia na wykresie.&#x0a;(cena − EMA8) / EMA8 × 100" />
                                </Border>
                                <Border Grid.Column="5">
                                    <controls:EmaDistanceControl Title="SPX VS EMA21" Value="{Binding Ema21Distance}" Detail="{Binding Ema21Detail}"
                                                                 ToolTip="O ile procent bieżąca cena SPX jest nad (▲) albo pod (▼) EMA21 ze świec 30 min (sesja kasowa) – tą samą co linia na wykresie.&#x0a;(cena − EMA21) / EMA21 × 100" />
                                </Border>
                            </Grid>
                        </Border>
                        <controls:CandleChartControl x:Name="BroadChart" Grid.Row="1"
                                                     Bars="{Binding BroadBars}"
                                                     Interval="Minutes30"
                                                     DisplayTimeZone="{Binding BroadTimeZone}"
                                                     TickSize="{Binding BroadTickSize}"
                                                     Appearance="{Binding BroadAppearance}"
                                                     EmptyText="{Binding BroadEmptyText}"
                                                     RightMarginPercent="{Binding BroadRightMargin}"
                                                     ShowDateAxis="True" />
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
        </Grid>
        <!--
            Obsługa wykresu:
            przeciągnij – przesuń | kółko – zoom pionowy | Ctrl+kółko – zoom poziomy | 2× klik – śledź cenę
            prawy przycisk – menu: linie cenowe, rozbijanie i łączenie profili | przeciągnij linię – zmień jej cenę
            Ctrl+przeciągnij linię – kopia linii
        -->
    </DockPanel>
</Window>
