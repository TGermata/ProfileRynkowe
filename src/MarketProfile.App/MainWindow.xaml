<Window x:Class="MarketProfile.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MarketProfile.App.Controls"
        Title="Market Profile – TPO" Height="800" Width="1300"
        Background="#14171C" WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <Window.Resources>
        <controls:TempoBrushConverter x:Key="TempoBrush" />
        <!-- Zamiana true/false na widoczny/ukryty (do pokazywania paska symulacji). -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8CDD4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SimButton" TargetType="Button">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <!-- Skok o cały profil (sesję) – ciemniejszy, ikona Windows „poprzedni / następny” (strzałka z kreską); odróżnia się od kroku o jeden słupek. -->
        <Style x:Key="SimProfileButton" TargetType="Button" BasedOn="{StaticResource SimButton}">
            <Setter Property="Background" Value="#3A4F6B" />
            <Setter Property="Foreground" Value="#E8EEF6" />
            <Setter Property="BorderBrush" Value="#5A7598" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <!-- Krok o jeden słupek (okres TPO) – jasny, pojedyncza strzałka (ikona Windows: szewron w lewo / w prawo). -->
        <Style x:Key="SimBarButton" TargetType="Button" BasedOn="{StaticResource SimButton}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <!-- Zakładki (ciemne): „Profil TPO” i „Wykres D/W/M”. -->
        <Style x:Key="DarkTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="#14171C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#808894" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Background="#1A1E24" BorderBrush="#2C313A" BorderThickness="1,1,1,0"
                                Padding="14,4" Margin="0,0,2,0" CornerRadius="4,4,0,0">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#2A3240" />
                                <Setter TargetName="Tab" Property="BorderBrush" Value="#5A7598" />
                                <Setter Property="Foreground" Value="#E8EEF6" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C8CDD4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Przełącznik interwału M / W / D – przycisk z zaznaczeniem. -->
        <Style x:Key="IntervalButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C8CDD4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="#262B33" BorderBrush="#3A4250" BorderThickness="1"
                                MinWidth="38" Height="26" Margin="0,0,4,0" CornerRadius="3" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#3A4F6B" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#5A7598" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#7A95B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SimSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Background" Value="#4A5260" />
        </Style>
    </Window.Resources>

    <!-- Układ okna: paski narzędzi u góry, pasek statusu na dole, wykres w środku. -->
    <DockPanel>

        <!-- Pasek narzędzi: wybór instrumentu, tryb pracy, start/stop, ustawienia. -->
        <Border DockPanel.Dock="Top" Background="#1E2229" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Instrument:" Style="{StaticResource BarText}" Margin="0,0,6,0" />
                <ComboBox Width="230" MaxDropDownHeight="500"
                          ItemsSource="{Binding Instruments}"
                          SelectedItem="{Binding SelectedInstrument}" />

                <!-- Tryb pracy: dane na żywo albo symulacja z lokalnej bazy. -->
                <TextBlock Text="Tryb:" Style="{StaticResource BarText}" Margin="20,0,6,0" />
                <RadioButton Content="Na żywo" IsChecked="{Binding IsLiveMode}" Foreground="#C8CDD4"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                <RadioButton Content="Symulacja" IsChecked="{Binding IsSimulationMode}" Foreground="#C8CDD4"
                             VerticalAlignment="Center" />

                <!-- Start/Stop tylko dla generatora (symulacją sterują przyciski paska symulacji, a dane od brokera
                     łączą się same – przy brokerze przycisk pojawia się jako „⟳ Połącz” tylko, gdy połączenie nie działa). -->
                <Button Content="{Binding StartStopText}" Command="{Binding StartStopCommand}"
                        Width="80" Margin="12,0,0,0"
                        Visibility="{Binding ShowStartStop, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="⚙ Ustawienia" Click="OnSettingsClick" Width="100" Margin="6,0,0,0" />
                <Button Content="▤ Parametry profili" Click="OnProfileStatsClick" Padding="8,0" Margin="6,0,0,0"
                        ToolTip="Tabela parametrów profili (kształt, otwarcie, migracja wartości, IB, ogony, nietknięte POC…) – zapisywanych w bazie dla algorytmów" />

                <!-- Elementy tylko dla zakładki „Profil TPO” (sesje, liczba profili, powiększenie, wolumen). -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsTpoTab, Converter={StaticResource BoolToVisibility}}">
                <!-- Szybkie pokazywanie/ukrywanie profili poszczególnych sesji. -->
                <TextBlock Text="Sesje:" Foreground="#C8CDD4" VerticalAlignment="Center" Margin="20,0,6,0" />
                <CheckBox Content="Nocna" IsChecked="{Binding ShowNightSession}" Foreground="#C8CDD4"
                          VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox Content="Dzienna" IsChecked="{Binding ShowDaySession}" Foreground="#C8CDD4"
                          VerticalAlignment="Center" />

                <!-- Ile ostatnich profili ma się mieścić na ekranie (dopasowanie szerokości + wczytanie historii). -->
                <TextBlock Text="Profile na ekranie:" Style="{StaticResource BarText}" Margin="20,0,6,0" />
                <ComboBox Width="55" ItemsSource="{Binding ProfileCountOptions}" SelectedItem="{Binding ProfilesOnScreen}"
                          ToolTip="Ile ostatnich profili zmieścić na ekranie przy dopasowaniu (⤢ / 2× klik / klawisz 0)." />

                <!-- Powiększanie widoku: oddal / przybliż / dopasuj do liczby profili. -->
                <Button Content="−" Width="26" Margin="8,0,0,0" Click="OnZoomOutClick"
                        ToolTip="Oddal – więcej profili na ekranie (kółko myszy w dół, klawisz −)" />
                <Button Content="+" Width="26" Margin="3,0,0,0" Click="OnZoomInClick"
                        ToolTip="Przybliż – zbliżenie na profil (kółko myszy w górę, klawisz +)" />
                <Button Content="⤢ Dopasuj" Padding="6,0" Margin="3,0,0,0" Click="OnZoomFitClick"
                        ToolTip="Dopasuj do wybranej liczby profili i wróć do najnowszych (2× klik na wykresie, klawisz 0)&#x0a;Kółko – powiększenie w obu osiach, Ctrl+kółko – tylko poziomo, Shift+kółko – tylko pionowo, przeciągnij – przesuń.&#x0a;Przesunięcie w lewo za najstarszy profil doczytuje starszą historię." />

                <!-- Profil wolumenowy: brak / tylko bieżący profil / wszystkie profile. -->
                <TextBlock Text="Wolumen:" Foreground="#C8CDD4" VerticalAlignment="Center" Margin="20,0,6,0" />
                <ComboBox Width="170" ItemsSource="{Binding VolumeModes}"
                          DisplayMemberPath="Value" SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedVolumeMode}" />
                </StackPanel>

                <TextBlock Text="{Binding SourceName}" Foreground="#808894" VerticalAlignment="Center" Margin="20,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Ostrzeżenia o danych: dane testowe (losowe), okres bez ticków (tylko świece), niezgodny tick z IB. -->
        <Border DockPanel.Dock="Top" Background="#B35C00" Padding="10,6" BorderBrush="#FF9A2E" BorderThickness="0,1,0,1"
                Visibility="{Binding HasDataWarning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding DataWarning}" Foreground="White" FontWeight="Bold" TextWrapping="Wrap" />
        </Border>

        <!-- Pasek symulacji (widoczny tylko w trybie symulacji):
             czas (data + godzina), profil wstecz, słupek wstecz, ▶ Play, ⏸ Pauza, słupek w przód, profil w przód, ⏹ Reset, czas końca, suwak prędkości, zegar. -->
        <Border DockPanel.Dock="Top" Background="#262B33" Padding="8,5" BorderBrush="#3A4250" BorderThickness="0,1,0,0"
                Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVisibility}}">
            <!-- Grupy kontrolek zawijają się do drugiego wiersza, gdy okno jest za wąskie (nic nie jest ucinane). -->
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <TextBlock Text="Czas:" Style="{StaticResource BarText}" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding SimStartDate}" Width="120" VerticalAlignment="Center"
                                ToolTip="Dzień symulacji – zmiana przenosi symulację do tego dnia" />
                    <TextBox Text="{Binding SimStartTime, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0,0,0"
                             VerticalContentAlignment="Center"
                             GotKeyboardFocus="OnSimTimeGotFocus" LostKeyboardFocus="OnSimTimeLostFocus" KeyDown="OnSimTimeKeyDown"
                             ToolTip="Czas aktualnie rysowanego TPO (GG:MM, strefa instrumentu). Wpisz inną godzinę i naciśnij Enter: w przód – profile dorysują się płynnie, wstecz – od razu znikną. Wykres zostaje dopasowany do ekranu." />
                    <TextBlock Text="{Binding TimeZoneLabel}" Foreground="#808894" VerticalAlignment="Center" Margin="4,0,12,0" />

                    <!-- Skoki: o cały profil (ciemne, pogrubione) i o jeden słupek TPO (jasne) – wstecz i w przód. -->
                    <Button ToolTip="Profil wstecz – cofnij do początku bieżącego profilu (z jego początku – do poprzedniego)"
                            Command="{Binding SimPrevProfileCommand}" Style="{StaticResource SimProfileButton}">
                        <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                    <Button ToolTip="Słupek wstecz – cofnij czas o jeden okres TPO (działa także w pauzie; przerwy bez danych są pomijane)"
                            Command="{Binding SimStepBackCommand}" Style="{StaticResource SimBarButton}">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                    <Border Style="{StaticResource SimSeparator}" />
                    <Button Content="▶" ToolTip="Play – odtwarzaj (po zmianie startu wczytuje symulację od nowa)"
                            Command="{Binding SimPlayCommand}" IsEnabled="{Binding CanSimPlay}" Style="{StaticResource SimButton}" />
                    <Button Content="⏸" ToolTip="Pauza"
                            Command="{Binding SimPauseCommand}" IsEnabled="{Binding IsSimPlaying}" Style="{StaticResource SimButton}" />
                    <Border Style="{StaticResource SimSeparator}" />
                    <Button ToolTip="Słupek w przód – przesuń czas o jeden okres TPO (działa także w pauzie)"
                            Command="{Binding SimStepCommand}" Style="{StaticResource SimBarButton}">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                    <Button ToolTip="Profil w przód – przeskocz do początku następnego profilu (działa także w pauzie)"
                            Command="{Binding SimNextProfileCommand}" Style="{StaticResource SimProfileButton}">
                        <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                    <Border Style="{StaticResource SimSeparator}" />
                    <Button Content="⏹" ToolTip="Reset – pauza i powrót do momentu, od którego wczytano symulację"
                            Command="{Binding SimResetCommand}" Style="{StaticResource SimButton}" />

                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <!-- Opcjonalny czas końca: puste = bez ograniczeń; zatrzymuje tylko, gdy wpisano datę i godzinę. -->
                    <TextBlock Text="Koniec:" Style="{StaticResource BarText}" Margin="14,0,6,0" />
                    <DatePicker SelectedDate="{Binding SimEndDate}" Width="120" VerticalAlignment="Center"
                                ToolTip="Dzień końca symulacji – puste = bez ograniczeń. Zatrzymanie działa tylko, gdy wpisano też godzinę." />
                    <TextBox Text="{Binding SimEndTime}" Width="50" Margin="4,0,0,0" VerticalContentAlignment="Center"
                             KeyDown="OnSimEndTimeKeyDown"
                             ToolTip="Godzina końca (GG:MM, strefa instrumentu) – po dojściu do niej odtwarzanie się wstrzymuje. Puste = bez ograniczeń." />
                    <Button Content="✕" Width="24" Margin="3,0,0,0" Command="{Binding SimClearEndCommand}"
                            ToolTip="Usuń czas końca – odtwarzanie bez ograniczeń" />

                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <!-- Prędkość: suwak w skali logarytmicznej (×1 … ×3600), działa także w trakcie odtwarzania. -->
                    <TextBlock Text="Prędkość:" Style="{StaticResource BarText}" Margin="16,0,6,0" />
                    <Slider Width="180" Minimum="0" Maximum="100" Value="{Binding SimSpeedSlider}"
                            VerticalAlignment="Center" SmallChange="1" LargeChange="10"
                            ToolTip="Prędkość symulacji (×1 – ×3600)" />
                    <TextBlock Text="{Binding SimSpeedText}" Style="{StaticResource BarText}" Width="140" Margin="8,0,0,0" />

                    <!-- Zegar symulacji. -->
                    <TextBlock Text="Zegar:" Style="{StaticResource BarText}" Margin="10,0,6,0" />
                    <TextBlock Text="{Binding SimClock}" Foreground="#30C070" FontFamily="Consolas" FontSize="14"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TimeZoneLabel}" Foreground="#808894" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>

                <!-- Zakres danych w bazie. -->
                <TextBlock Text="{Binding SimDataRange}" Foreground="#808894" VerticalAlignment="Center" Margin="12,2,0,2" />
            </WrapPanel>
        </Border>

        <!-- Pasek statusu: stan połączenia i podsumowanie bieżącego profilu. -->
        <Border DockPanel.Dock="Bottom" Background="#1E2229" Padding="8,4">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#808894" />
                    <TextBlock Text="{Binding Summary}" Foreground="#C8CDD4" FontFamily="Consolas" />
                </DockPanel>
                <!-- Tempo budowania TPO (liczba, stan, ostatnie zatrzymanie) – ukryte, gdy wyłączone. -->
                <TextBlock Text="{Binding TempoSummary}" FontFamily="Consolas" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"
                                    Value="{Binding TempoValue, Converter={StaticResource TempoBrush}, FallbackValue=#C8CDD4}" />
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <!-- Początek sesji – tempo jeszcze niemierzone: szary tekst, jak wskaźnik. -->
                                <DataTrigger Binding="{Binding TempoActive}" Value="False">
                                    <Setter Property="Foreground" Value="#6A717C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Stan pobierania w tle (nad paskiem statusu): czy trwa, dla której doby ticków i ile procent; ile dób ma komplet
             ticków. Można go ukryć w Ustawieniach → Dane i broker → Pobieranie i baza. -->
        <Border DockPanel.Dock="Bottom" Background="#1B2A3A" Padding="10,4" BorderBrush="#2E4A66" BorderThickness="0,1,0,0"
                Visibility="{Binding HasTickDownloadText, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding TickDownloadText}" Foreground="#9CC9F0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding TickDownloadText}" />
        </Border>

        <!-- Wykres profili – kontrolka dostaje tylko migawki danych (oddzielenie prezentacji od modelu). -->
        <!-- Akcje użytkownika (linie, rozbijanie profili) kontrolka zgłasza zdarzeniami obsługiwanymi w MainWindow.xaml.cs. -->
        <!-- Zakładki: profile TPO i wykres świecowy szerszej perspektywy (dzienny / tygodniowy / miesięczny). -->
        <TabControl Style="{StaticResource DarkTabControl}" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Profil TPO">
                <controls:ProfileChartControl x:Name="Chart"
                                              Profiles="{Binding Profiles}"
                                              Lines="{Binding Lines}"
                                              Averages="{Binding TpoAverages}"
                                              Appearance="{Binding Appearance}"
                                              PeriodTimerText="{Binding PeriodTimerText}"
                                              TempoValue="{Binding TempoValue}"
                                              TempoActive="{Binding TempoActive}"
                                              SimulationMenu="{Binding IsSimulationMode}"
                                              TempoStateText="{Binding TempoStateLabel}"
                                              ProfilesToFit="{Binding ProfilesOnScreen}" />
            </TabItem>

            <TabItem Header="Wykres D/W/M">
                <DockPanel>
                    <!-- Interwał, odświeżenie z IB i opis danych w bazie. -->
                    <Border DockPanel.Dock="Top" Background="#1E2229" Padding="8,5" BorderBrush="#2C313A" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <!-- Instrument bazowy albo rynek szeroki (np. ES / SPX) – ukryte, gdy wybrany instrument to sam rynek szeroki. -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasBroadMarketSwitch, Converter={StaticResource BoolToVisibility}}">
                                    <RadioButton Content="{Binding BaseSymbolLabel}" GroupName="CandleSymbol" IsChecked="{Binding IsBaseSelected}"
                                                 Style="{StaticResource IntervalButton}" ToolTip="Wybrany instrument" />
                                    <RadioButton Content="{Binding BroadSymbolLabel}" GroupName="CandleSymbol" IsChecked="{Binding IsBroadSelected}"
                                                 Style="{StaticResource IntervalButton}" ToolTip="{Binding BroadSymbolToolTip}" />
                                    <Border Style="{StaticResource SimSeparator}" Margin="10,0" />
                                </StackPanel>
                                <RadioButton Content="M" GroupName="CandleInterval" IsChecked="{Binding IsMonthly}"
                                             Style="{StaticResource IntervalButton}" ToolTip="Świece miesięczne (20 lat)" />
                                <RadioButton Content="W" GroupName="CandleInterval" IsChecked="{Binding IsWeekly}"
                                             Style="{StaticResource IntervalButton}" ToolTip="Świece tygodniowe (10 lat)" />
                                <RadioButton Content="D" GroupName="CandleInterval" IsChecked="{Binding IsDaily}"
                                             Style="{StaticResource IntervalButton}" ToolTip="Świece dzienne – pełna doba z sesją nocną (5 lat)" />

                                <!-- Rodzaj prezentacji (zapisywany w ustawieniach; kolory i średnie – Ustawienia → Wykres D/W/M). -->
                                <Border Style="{StaticResource SimSeparator}" Margin="10,0" />
                                <RadioButton Content="Świece" GroupName="CandleType" IsChecked="{Binding IsCandlesType}"
                                             Style="{StaticResource IntervalButton}" ToolTip="Świece japońskie" />
                                <RadioButton Content="OHLC" GroupName="CandleType" IsChecked="{Binding IsOhlcType}"
                                             Style="{StaticResource IntervalButton}" ToolTip="Słupki OHLC: kreska maksimum–minimum, otwarcie w lewo, zamknięcie w prawo" />

                                <!-- Skala: poziomo (szerokość świec) i pionowo (automatyczna / ręczna). -->
                                <Border Style="{StaticResource SimSeparator}" Margin="10,0" />
                                <Button Content="−" Width="26" Height="26" Click="OnCandleZoomOutClick"
                                        ToolTip="Węższe świece – więcej świec na ekranie (kółko myszy w dół)" />
                                <Button Content="+" Width="26" Height="26" Margin="3,0,0,0" Click="OnCandleZoomInClick"
                                        ToolTip="Szersze świece – mniej świec na ekranie (kółko myszy w górę)" />
                                <Button Content="↕ Skala auto" Padding="8,0" Height="26" Margin="3,0,0,0" Click="OnCandleAutoScaleClick"
                                        ToolTip="Skala pionowa dopasowana do widocznych świec (2× klik na osi cen).&#x0a;Skalę pionową zmienisz przeciągając oś cen w górę/w dół, kółkiem nad osią cen albo Shift+kółko." />
                                <Button Content="⤢ Najnowsze" Padding="8,0" Height="26" Margin="3,0,0,0" Click="OnCandleFitClick"
                                        ToolTip="Najnowsze świece przy prawej krawędzi, domyślna szerokość i skala auto (2× klik na wykresie).&#x0a;Przeciągnij – przesuń (przy ręcznej skali także w pionie)." />
                            </StackPanel>
                            <TextBlock Text="{Binding CandleInfo}" Foreground="#808894" VerticalAlignment="Center" Margin="16,0,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding CandleInfo}" />
                        </DockPanel>
                    </Border>
                    <controls:CandleChartControl x:Name="CandleChart"
                                                 Bars="{Binding CandleBars}"
                                                 Interval="{Binding CandleInterval}"
                                                 TickSize="{Binding CandleTickSize}"
                                                 Appearance="{Binding CandleAppearance}"
                                                 EmptyText="{Binding CandleEmptyText}" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Wolumen dziś / wczoraj">
                <DockPanel>
                    <!-- Które sesje są porównywane i suma do teraz. -->
                    <Border DockPanel.Dock="Top" Background="#1E2229" Padding="10,6" BorderBrush="#2C313A" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding VolumeSummary}" Foreground="#C8CDD4" FontSize="13"
                                   ToolTip="Wolumen bieżącej sesji w okresach TPO w porównaniu z tymi samymi okresami poprzedniej sesji tego samego rodzaju (dzienna z dzienną, nocna z nocną).&#x0a;Okres w trakcie porównywany jest do tej samej minuty. Odświeżanie co sekundę." />
                    </Border>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="150" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="2*" MinHeight="100" />
                        </Grid.RowDefinitions>

                        <!-- Okresy TPO (dziś / poprzednia sesja / różnica) i obok wolumen całkowity sesji. -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>
                            <controls:VolumeCompareChartControl Grid.Column="0" Result="{Binding VolumeResult}"
                                                                SelectedIndex="{Binding VolumeSelectedIndex}" />
                            <controls:SessionVolumeChartControl Grid.Column="1" Result="{Binding VolumeResult}"
                                                                ToolTip="Wolumen całkowity profilu: dziś do teraz, poprzednia sesja do tej samej chwili i cała poprzednia sesja (przerywana ramka – ile wolumenu zwykle przychodzi do końca sesji)." />
                        </Grid>
                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#2C313A" />

                        <DataGrid x:Name="VolumeGrid" Grid.Row="2" ItemsSource="{Binding VolumeRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectedIndex="{Binding VolumeSelectedIndex, Mode=TwoWay}" SelectionChanged="OnVolumeGridSelectionChanged"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False"
                                  CanUserReorderColumns="False" SelectionMode="Single"
                                  Background="#14171C" AlternationCount="2"
                                  Foreground="#C8CDD4" BorderThickness="0" HorizontalGridLinesBrush="#262B33"
                                  FontFamily="Consolas" FontSize="13">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E2229" />
                                    <Setter Property="Foreground" Value="#808894" />
                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                    <Setter Property="Padding" Value="10,5" />
                                    <Setter Property="BorderBrush" Value="#2C313A" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="10,3" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <!-- Zaznaczony wiersz (także kliknięciem słupków na wykresie) – w kolorze zaznaczenia wykresu. -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#24405F" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <!-- Liczby wyrównane do prawej. -->
                                <Style x:Key="NumberCell" TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                                <!-- Różnica: zielona = więcej niż w poprzedniej sesji, czerwona = mniej. -->
                                <Style x:Key="DiffCell" TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Sign}" Value="1">
                                            <Setter Property="Foreground" Value="#30C070" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Sign}" Value="-1">
                                            <Setter Property="Foreground" Value="#E05050" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <!-- Tło wierszy w stylu (nie RowBackground – DataGrid wymusza je i zasłania zaznaczenie). -->
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#181C22" />
                                    <Style.Triggers>
                                        <Trigger Property="AlternationIndex" Value="1">
                                            <Setter Property="Background" Value="#1C2027" />
                                        </Trigger>
                                        <!-- Okres w trakcie – pogrubiony; okresy przyszłe – przygaszone. -->
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Background" Value="#2A2A1E" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                            <Setter Property="Foreground" Value="#5A626E" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Litera" Binding="{Binding Letter}" Width="60" />
                                <DataGridTextColumn Header="Godziny" Binding="{Binding Hours}" Width="190" />
                                <DataGridTextColumn Header="Dziś" Binding="{Binding Today}" Width="130" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Poprzednia sesja" Binding="{Binding Previous}" Width="140" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Różnica" Binding="{Binding Difference}" Width="130" ElementStyle="{StaticResource DiffCell}" />
                                <DataGridTextColumn Header="Różnica %" Binding="{Binding DifferencePercent}" Width="100" ElementStyle="{StaticResource DiffCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
        <!--
            Obsługa wykresu:
            przeciągnij – przesuń | kółko – zoom pionowy | Ctrl+kółko – zoom poziomy | 2× klik – śledź cenę
            prawy przycisk – menu: linie cenowe, rozbijanie i łączenie profili | przeciągnij linię – zmień jej cenę
        -->
    </DockPanel>
</Window>
